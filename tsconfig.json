{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": "site/src",
    "outDir": "site/js",
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["site/src/**/*.ts"]
}
